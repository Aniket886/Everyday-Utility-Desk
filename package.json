{
  "name": "everyday-utility-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "concurrently \"vite\" \"node --watch server.mjs\"",
    "deps:update": "node scripts/prepare-dev.mjs --force",
    "setup": "npm install --no-audit --no-fund && npm run deps:update && npm run build",
    "build": "vite build",
    "start": "node server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "alasql": "^4.22.0",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^18.1.3",
    "mathjs": "^15.2.0",
    "mermaid": "^12.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "prettier": "^3.9.10",
    "tesseract.js": "^7.0.0",
    "youtube-dl-exec": "^3.0.20"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "tesseract.js@7.0.0": false,
    "youtube-dl-exec@3.1.19": true
  }
}

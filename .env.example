# Everyday Utility Desk environment template
# No environment file is required by the current application.
# This file documents supported process environment variables for future setup.
# Set PORT in the shell before npm start; server.mjs does not automatically load .env.

# Optional production server port. The default is 4174.
PORT=4174

# No AI API key is required by the current application.
# Do not add real secrets to this template.
# GROQ_API_KEY=[PLACEHOLDER_NOT_CURRENTLY_USED]
